flowchart TD
    Host["Client A<br/>Host<br/>C# WinForms<br/>capture Thread<br/>H.264/OpenH264 encode<br/>JPEG fallback"]
    Peer["Client B<br/>Controller<br/>C# WinForms<br/>H.264/JPEG render<br/>input + chat + file + clipboard"]
    LB["Load Balancer<br/>:10310 public HTTP<br/>/auth proxy<br/>/select-server returns tcp_endpoint"]
    Auth["Auth Server<br/>internal :8001<br/>register / login / logout<br/>JWT + JTI revocation"]
    DB["PostgreSQL<br/>internal :5433<br/>users + sessions"]

    subgraph Cluster["Main Server Cluster"]
        direction LR
        M1["main-server-1<br/>health :8000<br/>TCP :10311"]
        M2["main-server-2<br/>health :8003<br/>TCP :10312"]
        M3["main-server-3<br/>health :8004<br/>TCP :10313"]
    end

    Relay["Selected Main Server<br/>raw TCP framed socket<br/>JSON control plane<br/>NXF1 binary data plane<br/>JWT + room password validation<br/>host/controller only"]
    Lan["LAN mode<br/>client enters server IP<br/>HTTP http://ip:10310<br/>TCP ip:10311-10313"]

    Host -->|"login/register via /auth"| LB
    Peer -->|"login/register via /auth"| LB
    LB -->|"proxy auth"| Auth
    Auth -->|"read/write"| DB

    Host -->|"select-server"| LB
    Peer -->|"select-server"| LB
    LB -->|"health check"| M1
    LB -->|"health check"| M2
    LB -->|"health check"| M3
    LB -->|"tcp_endpoint"| Relay
    Lan -.-> LB

    Host -->|"TCP JSON create_room<br/>TCP binary NXF1 frames<br/>secure_payload clipboard/file/chat"| Relay
    Relay -->|"encrypted NXF1 frames<br/>room events"| Peer
    Peer -->|"TCP JSON join_room<br/>input/chat/file/clipboard"| Relay
    Relay -->|"approved input<br/>chat/file/clipboard"| Host

    classDef client fill:#eef4ff,stroke:#4a67b3,color:#122348,stroke-width:1.5px;
    classDef service fill:#eef9ef,stroke:#4a8f58,color:#18311f,stroke-width:1.5px;
    classDef data fill:#fff6e6,stroke:#c58727,color:#4f2d00,stroke-width:1.5px;
    classDef infra fill:#eef7fb,stroke:#3f7f97,color:#14313d,stroke-width:1.5px;

    class Host,Peer client;
    class Auth,LB,Relay service;
    class DB data;
    class M1,M2,M3,Lan infra;
